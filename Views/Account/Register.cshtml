@model QuanLyThuVien.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Thẻ Độc Giả";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7">
        <div class="card card-custom p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus-fill text-success" style="font-size: 3rem;"></i>
                    <h3 class="fw-bold mt-2">Đăng Ký Tài Khoản Độc Giả</h3>
                    <p class="text-muted small">Tự động kích hoạt thẻ thư viện và tài khoản đăng nhập</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-bold">Tên đăng nhập (*)</label>
                            <input asp-for="Username" class="form-control" required placeholder="VD: nguyenvanan" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HoTen" class="form-label fw-bold">Họ và Tên (*)</label>
                            <input asp-for="HoTen" class="form-control" required placeholder="VD: Nguyễn Văn An" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold">Mật khẩu (*)</label>
                            <input asp-for="Password" type="password" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">Xác nhận mật khẩu (*)</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SDT" class="form-label fw-bold">Số điện thoại (*)</label>
                            <input asp-for="SDT" class="form-control" required placeholder="VD: 0987654321" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="VD: an@gmail.com" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NgaySinh" class="form-label fw-bold">Ngày sinh</label>
                            <input asp-for="NgaySinh" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GioiTinh" class="form-label fw-bold">Giới tính</label>
                            <select asp-for="GioiTinh" class="form-select">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="DiaChi" class="form-label fw-bold">Địa chỉ</label>
                            <input asp-for="DiaChi" class="form-control" placeholder="VD: 123 Đường Nguyễn Huệ, TP.HCM" />
                        </div>
                    </div>

                    <div class="mt-4 pt-2">
                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Hoàn Tất Đăng Ký
                        </button>
                    </div>

                    <div class="text-center mt-3 small">
                        Đã có tài khoản? <a asp-action="Login" class="text-primary fw-bold">Đăng nhập tại đây</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

