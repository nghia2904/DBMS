@model QuanLyThuVien.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Hệ Thống";
}

<div class="row justify-content-center my-5">
    <div class="col-md-5">
        <div class="card card-custom p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock-fill text-primary" style="font-size: 3rem;"></i>
                    <h3 class="fw-bold mt-2">Đăng Nhập</h3>
                    <p class="text-muted small">Nhập tài khoản để truy cập hệ thống thư viện</p>
                </div>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-bold">Tên đăng nhập</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="Nhập username..." required autofocus />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu..." required />
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small">Ghi nhớ đăng nhập</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập
                    </button>
                </form>

                <!-- Nút nạp nhanh tài khoản mẫu để bảo vệ / demo -->
                <div class="mt-4 pt-3 border-top">
                    <label class="form-label small text-muted fw-bold d-block">Tài khoản mẫu dùng thử (Mật khẩu: Password@123):</label>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger btn-sm flex-fill fw-bold" onclick="fillLogin('admin', 'Password@123')">Admin</button>
                        <button type="button" class="btn btn-outline-success btn-sm flex-fill fw-bold" onclick="fillLogin('john.doe1', 'Password@123')">Thủ thư</button>
                        <button type="button" class="btn btn-outline-primary btn-sm flex-fill fw-bold" onclick="fillLogin('alice.johnson1', 'Password@123')">Độc giả</button>
                    </div>
                </div>

                <div class="text-center mt-3 small">
                    Chưa có tài khoản độc giả? <a asp-action="Register" class="text-primary fw-bold">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function fillLogin(u, p) {
        document.getElementById('Username').value = u;
        document.getElementById('Password').value = p;
    }
</script>
}

