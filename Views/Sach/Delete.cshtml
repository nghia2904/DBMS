@model QuanLyThuVien.Models.Sach
@{
    ViewData["Title"] = "Xóa Sách";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Sach" asp-action="Index">Danh sách sách</a></li>
                <li class="breadcrumb-item active">Xóa sách</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-danger mb-1"><i class="bi bi-trash me-2"></i>Xóa Sách Khỏi Kho</h2>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- CỘT TRÁI: THÔNG TIN SÁCH -->
    <div class="col-lg-4 col-md-5">
        <div class="card card-custom p-4 bg-white border-danger">
            <!-- Box bìa sách -->
            <div class="p-4 rounded-3 text-white mb-4 d-flex flex-column align-items-center justify-content-center shadow-sm"
                 style="min-height: 220px; background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);">
                <i class="bi bi-trash display-1 mb-2 text-warning"></i>
                <h5 class="fw-bold text-center px-2 mb-1">@Model.TenSach</h5>
                <small class="text-white-50">@Model.TenTacGia</small>
            </div>

            <!-- Thông tin sách -->
            <div class="p-3 bg-light rounded text-start small mb-4">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Mã sách:</span>
                    <strong class="text-dark">#@Model.MaSach</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Thể loại:</span>
                    <strong class="text-primary">@Model.TenTheLoai</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Số lượng hiện có:</span>
                    <strong class="text-info">@Model.SoLuong quyển</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Giá niêm yết:</span>
                    <strong class="text-danger">@(Model.GiaTien?.ToString("N0") ?? "0") đ</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: LỰA CHỌN & CẢNH BÁO -->
    <div class="col-lg-8 col-md-7">
        <!-- CẢNH BÁO LỚN -->
        <div class="alert alert-danger border-danger mb-4" role="alert">
            <h4 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>⚠️ CẢNH BÁO XÓA</h4>
            <hr>
            <p class="mb-2">Bạn sắp <strong>XÓA VĨNH VIỄN</strong> sách <strong>@Model.TenSach</strong> khỏi kho.</p>
            <p class="mb-3 text-danger"><strong>Hành động này KHÔNG THỂ HOÀN TÁC!</strong></p>
            
            <h6 class="fw-bold text-dark mt-3 mb-2">Điều này sẽ:</h6>
            <ul class="mb-3">
                <li>❌ Xóa tất cả 1 giao tác (Transaction) trong Stored Procedure</li>
                <li>❌ Xóa sách khỏi danh sách kho</li>
                <li>❌ Ảnh hưởng đến các phiếu mượn liên quan</li>
            </ul>

            <h6 class="fw-bold text-dark mt-3 mb-2">Chỉ thủ thư mới được phép xóa sách</h6>
            <p class="text-dark small mb-0">Xác nhận bằng cách nhập vào dòng dưới hoặc click nút [Xóa] ở cuối trang.</p>
        </div>

        <!-- FORM CONFIRMATION -->
        <div class="card card-custom p-4 bg-white border-danger">
            <h5 class="fw-bold text-danger mb-3"><i class="bi bi-clipboard-check me-2"></i>Xác Nhận Xóa</h5>
            
            <form method="post" asp-action="DeleteConfirm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaSach" />

                <div class="mb-3">
                    <label for="confirmText" class="form-label fw-bold">Nhập tên sách để xác nhận:</label>
                    <input type="text" class="form-control" id="confirmText" placeholder="Nhập '@Model.TenSach'..." value="" />
                    <small class="text-muted">Để bảo vệ, vui lòng nhập đúng tên sách để xác nhận xóa</small>
                </div>

                <div class="mb-3">
                    <label class="form-check">
                        <input type="checkbox" class="form-check-input" id="agreeCheck" />
                        <span class="form-check-label fw-bold">Tôi hiểu rằng hành động này KHÔNG THỂ HOÀN TÁC</span>
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Hủy - Quay Lại
                    </a>
                    <button type="submit" class="btn btn-danger fw-bold" id="deleteBtn" disabled>
                        <i class="bi bi-trash me-1"></i>Xóa Sách Vĩnh Viễn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SCRIPT XÁC NHẬN -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const confirmText = document.getElementById('confirmText');
    const agreeCheck = document.getElementById('agreeCheck');
    const deleteBtn = document.getElementById('deleteBtn');
    const bookName = '@Model.TenSach';

    function updateButtonState() {
        const isConfirmed = confirmText.value.trim().toLowerCase() === bookName.toLowerCase();
        const isAgreed = agreeCheck.checked;
        deleteBtn.disabled = !(isConfirmed && isAgreed);
    }

    confirmText.addEventListener('input', updateButtonState);
    agreeCheck.addEventListener('change', updateButtonState);

    // Prevent form submission with Enter key
    confirmText.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') e.preventDefault();
    });
});
</script>
