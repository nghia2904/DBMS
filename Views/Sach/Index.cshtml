@model List<QuanLyThuVien.Models.Sach>
@using System.Data
@using System.Security.Claims
@{
    ViewData["Title"] = "Khám phá sách - Thư Viện";
    var theLoaiList = ViewBag.TheLoaiList as DataTable;
    var tacGiaList = ViewBag.TacGiaList as DataTable;
    int? selectedTheLoai = ViewBag.SelectedTheLoai;
    int? selectedTacGia = ViewBag.SelectedTacGia;
    string? keyword = ViewBag.Keyword;

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var roleStr = User.FindFirst(ClaimTypes.Role)?.Value;
    var tenRole = User.FindFirst("TenRole")?.Value ?? "Khách";
    var hoTen = User.FindFirst("HoTen")?.Value ?? "Khách vãng lai";
    var maDocGia = User.FindFirst("MaDocGia")?.Value;
    var maNV = User.FindFirst("MaNV")?.Value;
}

<div class="row g-4">
    <!-- ================= SIDEBAR: CUSTOM THEO ROLE ================= -->
    <div class="col-lg-3 col-md-4">
        <div class="card card-custom p-3 bg-white sticky-top" style="top: 80px; z-index: 10;">
            
            <!-- THẺ THÔNG TIN NGƯỜI DÙNG / ROLE HEADER -->
            <div class="p-3 mb-3 rounded-3 text-white shadow-sm" 
                 style="background: @(roleStr == "4" ? "linear-gradient(135deg, #dc3545 0%, #a71d2a 100%)" : 
                                     roleStr == "2" ? "linear-gradient(135deg, #198754 0%, #146c43 100%)" : 
                                     roleStr == "3" ? "linear-gradient(135deg, #fd7e14 0%, #d65b00 100%)" : 
                                     roleStr == "1" ? "linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%)" : 
                                     "linear-gradient(135deg, #1e3c72 0%, #2a5298 100%)")">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi @(roleStr == "4" ? "bi-shield-fill-check" : 
                                   roleStr == "2" ? "bi-person-badge-fill" : 
                                   roleStr == "3" ? "bi-bar-chart-fill" : 
                                   roleStr == "1" ? "bi-person-vcard-fill" : 
                                   "bi-person-circle") fs-3 text-warning"></i>
                    <div>
                        <h6 class="mb-0 fw-bold text-truncate" style="max-width: 160px;" title="@hoTen">@hoTen</h6>
                        <span class="badge bg-white text-dark small">@tenRole</span>
                        @if (!string.IsNullOrEmpty(maDocGia)) { <small class="text-white ms-1">#ĐG-@maDocGia</small> }
                        @if (!string.IsNullOrEmpty(maNV)) { <small class="text-white ms-1">#NV-@maNV</small> }
                    </div>
                </div>
            </div>

            <!-- TIÊU ĐỀ MENU -->
            <div class="d-flex align-items-center justify-content-between mb-2 px-2">
                <span class="text-uppercase fw-bold text-muted small letter-spacing-1">
                    <i class="bi bi-grid-fill me-1 text-primary"></i> DANH MỤC
                </span>
                @if (selectedTheLoai != null || selectedTacGia != null || !string.IsNullOrEmpty(keyword))
                {
                    <a asp-action="Index" class="btn btn-link btn-sm p-0 text-decoration-none text-danger small">
                        <i class="bi bi-x-circle me-1"></i>Xóa lọc
                    </a>
                }
            </div>

            <div class="nav flex-column nav-pills gap-1">
                <!-- 1. Tất cả sách -->
                <a asp-action="Index" class="nav-link @(selectedTheLoai == null && selectedTacGia == null && string.IsNullOrEmpty(keyword) ? "active fw-bold" : "text-dark") d-flex justify-content-between align-items-center py-2 px-3 rounded-3">
                    <span><i class="bi bi-collection me-2 text-primary"></i> Tất cả sách</span>
                    <span class="badge @(selectedTheLoai == null && selectedTacGia == null ? "bg-white text-primary" : "bg-light text-muted border")">@(Model?.Count ?? 0)</span>
                </a>

                <!-- 2. Thể loại Dropdown -->
                <div class="mt-1">
                    <a class="nav-link text-dark fw-bold d-flex justify-content-between align-items-center py-2 px-3" data-bs-toggle="collapse" href="#collapseTheLoai" role="button">
                        <span><i class="bi bi-tags me-2 text-success"></i> Thể loại</span>
                        <i class="bi bi-chevron-down small"></i>
                    </a>
                    <div class="collapse show ps-3 pe-1 py-1" id="collapseTheLoai">
                        @if (theLoaiList != null)
                        {
                            foreach (DataRow row in theLoaiList.Rows)
                            {
                                int tlId = Convert.ToInt32(row["MaTheLoai"]);
                                bool isSelected = selectedTheLoai == tlId;
                                <a asp-action="Index" asp-route-maTheLoai="@tlId" asp-route-keyword="@keyword" 
                                   class="d-block py-1 px-2 rounded small text-decoration-none @(isSelected ? "bg-primary-subtle text-primary fw-bold" : "text-secondary")">
                                    • @row["TenTheLoai"]
                                </a>
                            }
                        }
                    </div>
                </div>

                <!-- 3. Tác giả Dropdown -->
                <div class="mt-1">
                    <a class="nav-link text-dark fw-bold d-flex justify-content-between align-items-center py-2 px-3" data-bs-toggle="collapse" href="#collapseTacGia" role="button">
                        <span><i class="bi bi-people me-2 text-warning"></i> Tác giả</span>
                        <i class="bi bi-chevron-down small"></i>
                    </a>
                    <div class="collapse ps-3 pe-1 py-1" id="collapseTacGia">
                        @if (tacGiaList != null)
                        {
                            foreach (DataRow row in tacGiaList.Rows)
                            {
                                int tgId = Convert.ToInt32(row["MaTacGia"]);
                                bool isSelected = selectedTacGia == tgId;
                                <a asp-action="Index" asp-route-maTacGia="@tgId" asp-route-keyword="@keyword" 
                                   class="d-block py-1 px-2 rounded small text-decoration-none @(isSelected ? "bg-primary-subtle text-primary fw-bold" : "text-secondary")">
                                    • @row["TenTacGia"]
                                </a>
                            }
                        }
                    </div>
                </div>

                <hr class="my-2">

                <!-- MENU RIÊNG CHO TỪNG ROLE -->
                @if (!isAuthenticated)
                {
                    <!-- Guest: Disable các chức năng cần đăng nhập -->
                    <a href="#" class="nav-link text-muted py-2 px-3 disabled" title="Cần đăng nhập">
                        <i class="bi bi-lock me-2"></i> Mượn sách <small class="text-muted">(Cần login)</small>
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="nav-link text-dark py-2 px-3">
                        <i class="bi bi-person me-2"></i> Tài khoản
                    </a>
                }
                else if (roleStr == "1") // Role 1: Độc giả
                {
                    <a asp-controller="PhieuMuon" asp-action="Index" class="nav-link text-dark py-2 px-3">
                        <i class="bi bi-journal-check me-2 text-info"></i> Phiếu mượn cá nhân
                    </a>
                }
                else if (roleStr == "2") // Role 2: Thủ thư
                {
                    <a asp-controller="PhieuMuon" asp-action="Create" class="nav-link text-success fw-bold py-2 px-3">
                        <i class="bi bi-plus-circle me-2"></i> Lập phiếu mượn
                    </a>
                    <a asp-controller="PhieuMuon" asp-action="Index" class="nav-link text-dark py-2 px-3">
                        <i class="bi bi-journal-bookmark me-2 text-info"></i> Quản lý trả & phạt
                    </a>
                    <a asp-controller="Sach" asp-action="Create" class="nav-link text-dark py-2 px-3">
                        <i class="bi bi-book-half me-2 text-primary"></i> Nhập sách mới
                    </a>
                }
                else if (roleStr == "3") // Role 3: Ban QL
                {
                    <a asp-controller="ThongKe" asp-action="Index" class="nav-link text-dark fw-bold py-2 px-3">
                        <i class="bi bi-bar-chart-line me-2 text-warning"></i> Thống kê báo cáo (Views)
                    </a>
                }
                else if (roleStr == "4") // Role 4: Admin
                {
                    <a asp-controller="Admin" asp-action="Index" class="nav-link text-danger fw-bold py-2 px-3">
                        <i class="bi bi-shield-lock me-2"></i> Quản lý tài khoản
                    </a>
                    <a asp-controller="PhieuMuon" asp-action="Index" class="nav-link text-dark py-2 px-3">
                        <i class="bi bi-journal-bookmark me-2 text-info"></i> Tất cả phiếu mượn
                    </a>
                    <a asp-controller="ThongKe" asp-action="Index" class="nav-link text-dark py-2 px-3">
                        <i class="bi bi-graph-up me-2 text-warning"></i> Báo cáo tổng thể
                    </a>
                }

                <!-- Menu Trọng Tâm: DBMS Concurrency Lab -->
                <div class="mt-3 p-2 bg-light rounded text-center border">
                    <small class="text-muted d-block mb-1 fw-bold">CHUYÊN ĐỀ ĐỒ ÁN</small>
                    <a asp-controller="DbmsLab" asp-action="Index" class="btn btn-danger btn-sm w-100 fw-bold shadow-sm">
                        <i class="bi bi-cpu-fill me-1"></i> DBMS Lab
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= MAIN CONTENT ================= -->
    <div class="col-lg-9 col-md-8">
        <!-- HEADER NỘI DUNG CHÍNH -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h3 class="fw-bold text-dark mb-1">Khám phá sách</h3>
                <p class="text-muted mb-0">
                    @if (roleStr == "2") { <span>Bàn làm việc Thủ thư — Tra cứu tồn kho & lập phiếu mượn</span> }
                    else if (roleStr == "1") { <span>Tra cứu sách & xem chi tiết để gửi yêu cầu mượn</span> }
                    else if (roleStr == "4") { <span>Quản trị toàn diện kho sách & thử nghiệm tương tranh</span> }
                    else { <span>Tra cứu kho sách — đăng ký để bắt đầu mượn</span> }
                </p>
            </div>
            
            @if (roleStr == "2" || roleStr == "4")
            {
                <div class="mt-2 mt-sm-0">
                    <a asp-action="Create" class="btn btn-success shadow-sm">
                        <i class="bi bi-plus-circle me-1"></i> Thêm Sách Mới (Thủ thư)
                    </a>
                </div>
            }
        </div>

        <!-- DANH SÁCH THẺ SÁCH (BOOK CARDS GRID) -->
        <div class="row g-4">
            @if (Model != null && Model.Count > 0)
            {
                foreach (var book in Model)
                {
                    var isHetSach = book.SoLuong == 0;
                    var isConIt = book.SoLuong > 0 && book.SoLuong <= 2;

                    <div class="col-lg-4 col-sm-6">
                        <div class="card card-custom h-100 p-3 bg-white d-flex flex-column border">
                            <!-- Image Box / Cover Placeholder -->
                            <div class="rounded-3 p-3 text-white text-center d-flex flex-column align-items-center justify-content-center mb-3 shadow-sm position-relative overflow-hidden"
                                 style="height: 140px; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                                <i class="bi bi-book-half fs-1 text-warning mb-1"></i>
                                <span class="small fw-bold text-truncate w-100 px-2" title="@book.TenTheLoai">@book.TenTheLoai</span>
                                <span class="position-absolute top-0 end-0 m-2 badge bg-dark bg-opacity-50 small">#@book.MaSach</span>
                            </div>

                            <!-- Thông tin tiêu đề & Tác giả -->
                            <div class="flex-grow-1">
                                <h6 class="fw-bold text-dark mb-1 line-clamp-2" style="min-height: 40px;" title="@book.TenSach">
                                    @book.TenSach
                                </h6>
                                <p class="text-muted small mb-1"><i class="bi bi-pen me-1"></i>@book.TenTacGia</p>
                                <p class="text-secondary small mb-2"><i class="bi bi-geo-alt me-1 text-danger"></i>@(book.ViTriKe ?? "Kệ chính")</p>
                            </div>

                            <!-- Footer của Thẻ: Badge trạng thái & Nút hành động tùy biến theo Role -->
                            <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
                                <!-- Badge Status -->
                                <div>
                                    @if (isHetSach)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            Hết sách
                                        </span>
                                    }
                                    else if (isConIt)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1">
                                            Còn ít (@book.SoLuong)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            Còn sách
                                        </span>
                                    }
                                </div>

                                <!-- Action Button: Xem chi tiết -->
                                <a asp-action="Details" asp-route-id="@book.MaSach" class="btn btn-outline-primary btn-sm px-3 fw-bold">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="card card-custom p-5 text-center bg-white">
                        <i class="bi bi-journal-x text-muted display-4 mb-3"></i>
                        <h5 class="fw-bold text-dark">Không tìm thấy sách nào</h5>
                        <p class="text-muted small">Hãy thử tìm với từ khóa khác hoặc xóa bộ lọc thể loại/tác giả.</p>
                        <div>
                            <a asp-action="Index" class="btn btn-primary btn-sm">Xem tất cả sách</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- NOTIFICATION BANNER TÙY BIẾN THEO ROLE -->
        <div class="card card-custom p-4 mt-5 border-0 text-white" 
             style="background: @(roleStr == "2" ? "linear-gradient(135deg, #198754 0%, #146c43 100%)" : 
                                 roleStr == "4" ? "linear-gradient(135deg, #dc3545 0%, #8b111e 100%)" : 
                                 "linear-gradient(135deg, #1e3c72 0%, #2a5298 100%)");">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi @(roleStr == "2" ? "bi-patch-check-fill" : roleStr == "4" ? "bi-cpu-fill" : "bi-info-circle-fill") text-warning fs-2"></i>
                        <div>
                            @if (!isAuthenticated)
                            {
                                <h5 class="fw-bold mb-1">Đăng nhập để mượn sách</h5>
                                <p class="mb-0 text-white-50 small">
                                    Tạo tài khoản miễn phí để bắt đầu mượn tối đa 5 quyển mỗi lần và tra cứu lịch sử mượn trả trực tuyến.
                                </p>
                            }
                            else if (roleStr == "1")
                            {
                                <h5 class="fw-bold mb-1">Xin chào độc giả @hoTen!</h5>
                                <p class="mb-0 text-white-50 small">
                                    Bạn có thể xem chi tiết từng đầu sách và đến quầy thủ thư xuất trình mã thẻ #ĐG-@maDocGia để mượn sách.
                                </p>
                            }
                            else if (roleStr == "2")
                            {
                                <h5 class="fw-bold mb-1">Bàn làm việc Thủ thư</h5>
                                <p class="mb-0 text-white-50 small">
                                    Sử dụng nút 'Lập phiếu mượn' hoặc 'Mượn & Trả sách' để thao tác ghi nhận giao dịch lưu thông sách.
                                </p>
                            }
                            else
                            {
                                <h5 class="fw-bold mb-1">Bảng điều khiển Quản trị viên (Admin)</h5>
                                <p class="mb-0 text-white-50 small">
                                    Hệ thống quản lý toàn diện cơ sở dữ liệu thư viện kết hợp Phòng thí nghiệm kiểm soát tương tranh.
                                </p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    @if (!isAuthenticated)
                    {
                        <div class="d-flex gap-2 justify-content-md-end">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-sm px-3 fw-bold">Đăng nhập</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-warning btn-sm px-3 fw-bold">Đăng ký</a>
                        </div>
                    }
                    else if (roleStr == "1")
                    {
                        <a asp-controller="PhieuMuon" asp-action="Index" class="btn btn-light btn-sm px-3 fw-bold">Xem lịch sử của tôi</a>
                    }
                    else if (roleStr == "2")
                    {
                        <a asp-controller="PhieuMuon" asp-action="Create" class="btn btn-light btn-sm px-3 fw-bold">Lập phiếu mượn</a>
                    }
                    else if (roleStr == "4")
                    {
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-light btn-sm px-3 fw-bold">Quản trị tài khoản</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
