@using System.Data
@{
    ViewData["Title"] = "Lập Phiếu Mượn Sách Mới";
    var docGiaList = ViewBag.DocGiaList as DataTable;
    var sachList = ViewBag.SachList as DataTable;
    int? selectedMaSach = ViewBag.SelectedMaSach;
}

<div class="row justify-content-center my-4">
    <div class="col-md-8">
        <div class="card card-custom p-4 bg-white">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-4 border-bottom pb-3">
                    <i class="bi bi-journal-plus text-success fs-3"></i>
                    <div>
                        <h4 class="fw-bold mb-0">Lập Phiếu Mượn Sách (Thủ Thư)</h4>
                        <small class="text-muted">Mỗi thao tác gửi yêu cầu tương ứng với 1 Giao tác ($T$) trong hệ thống</small>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn Độc Giả Mượn (*):</label>
                        <select name="maDocGia" class="form-select form-select-lg" required>
                            <option value="">-- Chọn độc giả --</option>
                            @if (docGiaList != null)
                            {
                                foreach (DataRow row in docGiaList.Rows)
                                {
                                    <option value="@row["MaDocGia"]">#@row["MaDocGia"] - @row["HoTen"] (SĐT: @row["SDT"])</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn Sách Cần Mượn (*):</label>
                        <select name="maSach" class="form-select form-select-lg" required>
                            <option value="">-- Chọn đầu sách trong kho --</option>
                            @if (sachList != null)
                            {
                                foreach (DataRow row in sachList.Rows)
                                {
                                    var sel = selectedMaSach.HasValue && Convert.ToInt32(row["MaSach"]) == selectedMaSach.Value;
                                    <option value="@row["MaSach"]" selected="@sel">
                                        #@row["MaSach"] - @row["TenSach"] (Tồn kho: @row["SoLuong"] quyển)
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- ================= CẤU HÌNH GIAO TÁC DBMS CHO 2 TAB ================= -->
                    <div class="card border-primary mb-4 shadow-sm">
                        <div class="card-header bg-primary bg-opacity-10 py-3">
                            <h6 class="mb-0 fw-bold text-primary d-flex align-items-center gap-2">
                                <i class="bi bi-cpu-fill text-danger"></i>
                                <span>Cấu Hình Giao Tác Demo Tương Tranh (Dành Khi Mở 2 Tab)</span>
                            </h6>
                        </div>
                        <div class="card-body p-3 bg-light">
                            <div class="row g-3 align-items-center">
                                <div class="col-md-8">
                                    <label class="form-label small fw-bold">Chọn Chế Độ Giao Tác:</label>
                                    <select name="dbmsMode" class="form-select">
                                        <option value="" selected>1. Nghiệp vụ mượn sách bình thường (Không delay)</option>
                                        <option value="LostUpdate_Loi">2. [Demo Lost Update] Chưa xử lý (Đọc -> Delay 5s -> Trừ kho)</option>
                                        <option value="LostUpdate_KhacPhuc">3. [Demo Lost Update] Đã khắc phục (Dùng UPDLOCK, HOLDLOCK -> Delay 5s)</option>
                                        <option value="Deadlock_T1_Loi">4. [Demo Deadlock Tab 1] Khóa Độc giả 1 -> Delay 3s -> Khóa Sách 2 (Gây lỗi 1205)</option>
                                        <option value="Deadlock_T1_KhacPhuc">5. [Demo Deadlock Tab 1] Đã khắc phục (Resource Ordering chuẩn)</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold">Độ trễ Giao tác (Delay):</label>
                                    <select name="delaySec" class="form-select">
                                        <option value="3">3 Giây</option>
                                        <option value="5" selected>5 Giây (Để kịp chuyển Tab)</option>
                                        <option value="8">8 Giây</option>
                                    </select>
                                </div>
                            </div>
                            <small class="text-muted d-block mt-2">
                                <i class="bi bi-info-circle me-1"></i>
                                <em>Cách test 2 Tab: Mở 2 tab trình duyệt cùng form này, Tab 1 chọn 'Lost Update Chưa xử lý' bấm Mượn, ngay lập tức qua Tab 2 bấm Mượn cùng cuốn sách đó.</em>
                            </small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Xác Nhận Mượn Sách (Giao tác)
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
