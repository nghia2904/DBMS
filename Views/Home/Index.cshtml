@using System.Data
@{
    ViewData["Title"] = "Trang Chủ - Quản Lý Thư Viện";
    var stats = ViewBag.Stats as DataTable;
    var sachMoi = ViewBag.SachMoi as DataTable;
    DataRow? statRow = stats != null && stats.Rows.Count > 0 ? stats.Rows[0] : null;
}

<!-- HERO BANNER -->
<div class="p-5 mb-4 rounded-3 bg-white shadow-sm border position-relative overflow-hidden">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-2">HỆ QUẢN TRỊ CSDL .NET 10 & SQL SERVER</span>
            <h1 class="display-5 fw-bold text-dark mb-3">Hệ Thống Quản Lý Thư Viện Số</h1>
            <p class="lead text-muted mb-4">
                Giải pháp toàn diện quản lý danh mục sách, lưu thông mượn trả, độc giả và phân tích thống kê. Tích hợp trực quan bộ thí nghiệm điều khiển tương tranh và giải quyết Deadlock.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Sach" asp-action="Index" class="btn btn-primary btn-lg px-4 shadow-sm">
                    <i class="bi bi-search me-1"></i> Tra cứu danh mục sách
                </a>
                <a asp-controller="DbmsLab" asp-action="Index" class="btn btn-dbms-lab btn-lg px-4 shadow-sm">
                    <i class="bi bi-cpu-fill me-1 text-warning"></i> Phòng Thí Nghiệm DBMS
                </a>
            </div>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <i class="bi bi-journal-bookmark text-primary" style="font-size: 8rem; opacity: 0.85;"></i>
        </div>
    </div>
</div>

<!-- KPI CARDS -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card card-custom p-3 bg-white border-start border-4 border-primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Tổng Đầu Sách</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@(statRow != null ? statRow["TongSach"] : "37")</h3>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                    <i class="bi bi-book fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card card-custom p-3 bg-white border-start border-4 border-success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Tổng Độc Giả</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@(statRow != null ? statRow["TongDocGia"] : "14")</h3>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="bi bi-people fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card card-custom p-3 bg-white border-start border-4 border-warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Đang Mượn</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@(statRow != null ? statRow["DangMuon"] : "18")</h3>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card card-custom p-3 bg-white border-start border-4 border-danger">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Quá Hạn</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@(statRow != null ? statRow["QuaHan"] : "2")</h3>
                </div>
                <div class="p-3 bg-danger-subtle text-danger rounded-circle">
                    <i class="bi bi-exclamation-triangle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SÁCH NỔI BẬT & MỚI NHẤT -->
<div class="card card-custom mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-star-fill text-warning me-2"></i>Danh Mục Sách Mới Cập Nhật</h5>
        <a asp-controller="Sach" asp-action="Index" class="btn btn-outline-primary btn-sm">Xem tất cả <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="card-body p-4">
        <div class="row g-3">
            @if (sachMoi != null)
            {
                foreach (DataRow row in sachMoi.Rows)
                {
                    <div class="col-lg-3 col-md-6">
                        <div class="card h-100 border shadow-sm p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-secondary-subtle text-dark">@row["TenTheLoai"]</span>
                                <span class="badge @(Convert.ToInt32(row["SoLuong"]) > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                    @(Convert.ToInt32(row["SoLuong"]) > 0 ? $"Còn {row["SoLuong"]} q" : "Hết sách")
                                </span>
                            </div>
                            <h6 class="fw-bold text-dark mb-1 text-truncate" title="@row["TenSach"]">@row["TenSach"]</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-pen me-1"></i>@row["TenTacGia"]</p>
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="text-primary fw-bold">@Convert.ToDecimal(row["GiaTien"]).ToString("N0") đ</span>
                                <a asp-controller="Sach" asp-action="Index" asp-route-keyword="@row["TenSach"]" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
