@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Quản Lý Thể Loại Sách";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-tags me-2 text-primary"></i>Quản Lý Thể Loại Sách</h2>
        <p class="text-muted mb-0">Thêm, sửa, xóa các thể loại sách trong kho — chỉ thủ thư mới được phép</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a href="#" data-bs-toggle="modal" data-bs-target="#modalThemTheLoai" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm Thể Loại
        </a>
    </div>
</div>

<!-- DANH SÁCH THỂ LOẠI -->
<div class="card card-custom bg-white">
    <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-list me-2"></i>Danh Sách Thể Loại</h5>
        <span class="badge bg-primary">@(Model?.Rows.Count ?? 0) thể loại</span>
    </div>

    @if (Model != null && Model.Rows.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">STT</th>
                        <th>Tên Thể Loại</th>
                        <th>Mô Tả</th>
                        <th class="text-center">Ngày Mượn Tối Đa</th>
                        <th class="text-center">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (DataRow row in Model.Rows)
                        {
                            int maTheLoai = Convert.ToInt32(row["MaTheLoai"]);
                            string tenTheLoai = row["TenTheLoai"].ToString();
                            string moTa = row["MoTa"] != DBNull.Value ? row["MoTa"].ToString() : "-";
                            int soNgayMuon = Convert.ToInt32(row["SoNgayMuonToiDa"]);

                            <tr>
                                <td class="ps-3">@index</td>
                                <td><strong>@tenTheLoai</strong></td>
                                <td><small class="text-muted">@moTa</small></td>
                                <td class="text-center">@soNgayMuon ngày</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#modalSuaTheLoai@maTheLoai">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </button>
                                    <form method="post" asp-action="XoaTheLoai" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maTheLoai" value="@maTheLoai" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa thể loại này?');">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>

                            <!-- MODAL SỬA -->
                            <div class="modal fade" id="modalSuaTheLoai@maTheLoai" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header bg-warning text-dark">
                                            <h5 class="modal-title">Sửa Thể Loại</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form method="post" asp-action="SuaTheLoai">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-body">
                                                <input type="hidden" name="maTheLoai" value="@maTheLoai" />
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Tên Thể Loại</label>
                                                    <input type="text" class="form-control" name="tenTheLoai" value="@tenTheLoai" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Mô Tả</label>
                                                    <textarea class="form-control" name="moTa" rows="2">@moTa</textarea>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Số Ngày Mượn Tối Đa</label>
                                                    <input type="number" class="form-control" name="soNgayMuonToiDa" value="@soNgayMuon" required />
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <button type="submit" class="btn btn-warning">Lưu Thay Đổi</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-center py-5">
            <p class="text-muted">Chưa có thể loại nào. Hãy thêm thể loại mới.</p>
        </div>
    }
</div>

<!-- MODAL THÊM THỂLOẠI -->
<div class="modal fade" id="modalThemTheLoai" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Thêm Thể Loại</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="ThemTheLoai">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Thể Loại</label>
                        <input type="text" class="form-control" name="tenTheLoai" placeholder="Ví dụ: Sách kỹ thuật" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô Tả</label>
                        <textarea class="form-control" name="moTa" placeholder="Mô tả ngắn gọn..." rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số Ngày Mượn Tối Đa</label>
                        <input type="number" class="form-control" name="soNgayMuonToiDa" value="30" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">Thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>
