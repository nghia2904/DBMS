@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Quản Lý Tác Giả";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold text-dark mb-1"><i class="bi bi-pen me-2 text-primary"></i>Quản Lý Tác Giả</h2>
        <p class="text-muted mb-0">Thêm, sửa, xóa các tác giả — chỉ thủ thư mới được phép</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a href="#" data-bs-toggle="modal" data-bs-target="#modalThemTacGia" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm Tác Giả
        </a>
    </div>
</div>

<div class="card card-custom bg-white">
    <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-list me-2"></i>Danh Sách Tác Giả</h5>
        <span class="badge bg-primary">@(Model?.Rows.Count ?? 0) tác giả</span>
    </div>

    @if (Model != null && Model.Rows.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">STT</th>
                        <th>Tên Tác Giả</th>
                        <th>Ngày Sinh</th>
                        <th>Quốc Tích</th>
                        <th class="text-center">Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (DataRow row in Model.Rows)
                        {
                            int maTacGia = Convert.ToInt32(row["MaTacGia"]);
                            string tenTacGia = row["TenTacGia"].ToString();
                            string ngaySinh = row["NgaySinh"] != DBNull.Value ? Convert.ToDateTime(row["NgaySinh"]).ToString("dd/MM/yyyy") : "-";
                            string quocTich = row["QuocTich"] != DBNull.Value ? row["QuocTich"].ToString() : "-";

                            <tr>
                                <td class="ps-3">@index</td>
                                <td><strong>@tenTacGia</strong></td>
                                <td>@ngaySinh</td>
                                <td>@quocTich</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#modalSuaTacGia@maTacGia">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </button>
                                    <form method="post" asp-action="XoaTacGia" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maTacGia" value="@maTacGia" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa tác giả này?');">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>

                            <div class="modal fade" id="modalSuaTacGia@maTacGia" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header bg-warning text-dark">
                                            <h5 class="modal-title">Sửa Tác Giả</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form method="post" asp-action="SuaTacGia">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-body">
                                                <input type="hidden" name="maTacGia" value="@maTacGia" />
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Tên Tác Giả</label>
                                                    <input type="text" class="form-control" name="tenTacGia" value="@tenTacGia" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Ngày Sinh</label>
                                                    <input type="date" class="form-control" name="ngaySinh" value="@(row["NgaySinh"] != DBNull.Value ? Convert.ToDateTime(row["NgaySinh"]).ToString("yyyy-MM-dd") : "")" />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Quốc Tích</label>
                                                    <input type="text" class="form-control" name="quocTich" value="@quocTich" />
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <button type="submit" class="btn btn-warning">Lưu</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-center py-5">
            <p class="text-muted">Chưa có tác giả nào.</p>
        </div>
    }
</div>

<div class="modal fade" id="modalThemTacGia" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Thêm Tác Giả</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="ThemTacGia">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Tác Giả</label>
                        <input type="text" class="form-control" name="tenTacGia" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ngày Sinh</label>
                        <input type="date" class="form-control" name="ngaySinh" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Quốc Tích</label>
                        <input type="text" class="form-control" name="quocTich" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">Thêm</button>
                </div>
            </form>
        </div>
    </div>
</div>
